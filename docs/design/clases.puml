@startuml clases-votacion
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classBackgroundColor #EEF2F8
skinparam classBorderColor #1A3A5C
title VotoEPIS — Módulos Elección y Votación (diseño actualizado en el Lab 07)
skinparam nodesep 25
skinparam ranksep 40

class Estudiante {
  - id: UUID
  - correoInstitucional: String
}
class Eleccion {
  - id: UUID
  - nombre: String
  - apertura: DateTime
  - cierre: DateTime
  - etapa: Etapa <<State>>
  - totalPadron: int
  - discrepancias: int
  + configurar(nombre: String, apertura: DateTime, cierre: DateTime, totalPadron: int): void
  + agregarLista(lista: Lista): void
  + abrir(): void
  + estado(): EstadoEleccion
  + cambiarA(etapa: Etapa): void
  + reconstruir(estado: String): Eleccion
  + estaAbierta(ahora: DateTime): bool
  + verificarVotable(ahora: DateTime): void
  + cerrar(ahora: DateTime): void
  + registrarDiscrepancia(): void
  + escrutar(votos: int, participaciones: int, auditorCoincide: bool): void
  + publicar(actaFirmada: bool): void
}
class Lista {
  - id: UUID
  - nombre: String
}
enum EstadoEleccion {
  CONFIGURADA
  ABIERTA
  CERRADA
  ESCRUTADA
  PUBLICADA
}
class Participacion {
  - fechaHora: DateTime
  + emitirComprobante(): Comprobante
}
class Voto {
  - id: UUID
}
class Comprobante {
  - codigo: String
  - fechaHora: DateTime
}
interface CanalComprobante <<Strategy>> {
  + enviarComprobante(correo: String, comprobante: Comprobante): void
}
interface RepositorioVotacion <<puerto>> {
  + buscarEleccion(id: UUID): Eleccion
  + buscarLista(id: UUID, eleccionId: UUID): Lista
  + buscarEstudiante(id: UUID): Estudiante
  + registrar(participacion: Participacion, voto: Voto): void
}
class CorreoAdapter <<Adapter>>
class RepositorioAdapter <<Adapter>>
class RepositorioConReintentos <<Decorator>>
class FabricaCanales <<Factory>>
class PublicadorEventos <<Observer>>
abstract class Etapa <<State>> {
  + verificarVotable(eleccion: Eleccion, ahora: DateTime): void
}
class ServicioVotacion <<servicio>> {
  + emitirVoto(estudianteId: UUID, eleccionId: UUID, listaId: UUID, ahora: DateTime): Comprobante
  + consultarReglamento(pregunta: String, proveedor: String): String
}

Eleccion "1" *-- "1..*" Lista : ofrece >
Estudiante "1" -- "0..*" Participacion : participa >
Eleccion "1" -- "0..*" Participacion : registra >
Eleccion "1" -- "0..*" Voto : urna >
Lista "1" -- "0..*" Voto : recibe >
Eleccion "0..*" --> "1" EstadoEleccion
CanalComprobante <|.. CorreoAdapter
RepositorioVotacion <|.. RepositorioAdapter
RepositorioVotacion <|.. RepositorioConReintentos
RepositorioConReintentos ..> RepositorioVotacion : envuelve
FabricaCanales ..> CanalComprobante : crea
Eleccion "1" --> "1" Etapa : etapa actual
ServicioVotacion ..> FabricaCanales
ServicioVotacion ..> PublicadorEventos
Participacion ..> Comprobante
ServicioVotacion ..> Participacion
ServicioVotacion ..> Voto
ServicioVotacion ..> Comprobante
ServicioVotacion ..> RepositorioVotacion
ServicioVotacion ..> CanalComprobante

note right of Voto
  Sin asociación con Estudiante
  ni con Participacion, y sin
  marca de tiempo (ADR-002, R-06).
end note
@enduml
